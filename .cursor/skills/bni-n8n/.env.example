# BNI Brasil n8n — local secrets template.
#
# Copy this file to ".env" (same folder) and fill in the real values, OR export
# these variables in your shell profile. The ".env" file is gitignored and must
# never be committed. For Cursor Cloud Agents, set these as Cursor secrets so
# they are injected as environment variables instead.

# Base URL of the n8n instance (optional; this is the default).
BNI_N8N_URL=https://n8n.bnibrasil.com.br

# Public REST API key — sent as the X-N8N-API-KEY header (aud: public-api).
BNI_N8N_API_KEY=

# MCP Access Token — sent as Authorization: Bearer (aud: mcp-server-api).
# From n8n: Settings -> Instance-level MCP -> Connection details -> Access Token.
BNI_N8N_MCP_TOKEN=
